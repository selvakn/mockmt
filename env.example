# OAuth Server Configuration
OAUTH_CLIENT_ID=your_oauth_client_id_here
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
OAUTH_AUTH_URL=https://your-oauth-server/auth/realms/your-realm/protocol/openid-connect/auth
OAUTH_TOKEN_URL=https://your-oauth-server/auth/realms/your-realm/protocol/openid-connect/token
OAUTH_USERINFO_URL=https://your-oauth-server/auth/realms/your-realm/protocol/openid-connect/userinfo
OAUTH_REDIRECT_URI=http://localhost:8080/auth/callback
OAUTH_SCOPES=openid email profile

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database Configuration
DATABASE_URL=./webmail.db

# Server Configuration
PORT=8080
SMTP_PORT=25
FRONTEND_URL=http://localhost:3000

# SMTP Authentication (required - the server will not start without these)
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here

# --- Relay mode (opt-in; disabled by default) ------------------------
RELAY_ENABLED=false
RELAY_HOST=smtp.gmail.com
RELAY_PORT=587
RELAY_TLS_MODE=starttls
RELAY_USERNAME=you@gmail.com
RELAY_PASSWORD=your_16_char_app_password
RELAY_IDENTITY=you@gmail.com
RELAY_TIMEOUT_SECONDS=10
# RELAY_CA_CERT_FILE=/etc/ssl/certs/internal-ca.pem

# Who may review and release queued mail (required, non-empty, when relay is enabled)
REVIEWER_EMAILS=alice@example.com,bob@example.com

# Limits and memory (see quickstart.md for the sizing formula)
MAX_MESSAGE_BYTES=26214400
SMTP_MAX_CONCURRENT=3
RELAY_MAX_CONCURRENT_IO=2
SMTP_READ_TIMEOUT_SECONDS=60
SMTP_WRITE_TIMEOUT_SECONDS=60

# Retention (0 disables purging; content-only purge, metadata/audit kept forever)
RETENTION_DAYS=0 